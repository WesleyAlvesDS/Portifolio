---
import { resume } from '../data/resume';
const { mindmap } = resume;
---

<section class="section mindmap-section" id="habilidades">
  <div class="container">
    <div data-reveal>
      <p class="section-label">// Habilidades</p>
      <h2 class="section-title">Mapa Mental de Competências</h2>
      <p class="section-subtitle">Visão interativa das minhas habilidades técnicas e ferramentas.</p>
    </div>

    <div class="mindmap-canvas-wrapper" data-reveal="delay-1">
      <canvas class="mindmap-canvas" id="mindmap-canvas"></canvas>
      <div class="mindmap-tooltip" id="mindmap-tooltip"></div>
    </div>

    <div class="mindmap-cards" data-reveal="delay-1">
      {mindmap.branches.map((branch) => (
        <div class="mindmap-card" style={`--card-accent: ${branch.color}`}>
          <div class="mindmap-card-header">
            <span class="mindmap-card-dot" style={`background: ${branch.color}`}></span>
            <h3 class="mindmap-card-title">{branch.label}</h3>
          </div>
          <ul class="mindmap-card-list">
            {branch.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mindmap-legend" data-reveal="delay-2">
      {mindmap.branches.map((branch) => (
        <div class="legend-item">
          <span class="legend-dot" style={`background: ${branch.color}`}></span>
          <span class="legend-label">{branch.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script define:vars={{ mindmap }}>
  function drawMindmap() {
    const canvas = document.getElementById('mindmap-canvas');
    if (!canvas) return;
    const wrapper = canvas.parentElement;
    const isMobile = window.innerWidth < 768;

    if (isMobile) {
      wrapper.style.display = 'none';
      return;
    } else {
      wrapper.style.display = '';
    }

    const tooltip = document.getElementById('mindmap-tooltip');
    const dpr = window.devicePixelRatio || 1;

    const rect = wrapper.getBoundingClientRect();
    const w = rect.width;
    const h = rect.height;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';

    const ctx = canvas.getContext('2d');
    ctx.scale(dpr, dpr);

    const padding = Math.min(w, h) * 0.08;
    const cx = w / 2;
    const cy = h / 2;
    const centerR = Math.min(w, h) * 0.065;
    const branchR = Math.min(w - padding * 2, h - padding * 2) * 0.3;
    const leafDist = Math.min(w, h) * 0.17;
    const fontSize = Math.max(10, Math.min(w, h) * 0.022);

    const branches = mindmap.branches;
    const angleStep = (Math.PI * 2) / branches.length;
    const startAngle = -Math.PI / 2;

    const nodes = [];

    function getThemeColors() {
      const s = getComputedStyle(document.documentElement);
      return {
        text: s.getPropertyValue('--text-primary').trim() || '#e4e4e7',
        textSec: s.getPropertyValue('--text-secondary').trim() || '#a1a1aa',
      };
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      const colors = getThemeColors();

      // center glow
      const cg = ctx.createRadialGradient(cx, cy, 0, cx, cy, centerR * 3);
      cg.addColorStop(0, 'rgba(0,212,170,0.07)');
      cg.addColorStop(1, 'rgba(0,212,170,0)');
      ctx.fillStyle = cg;
      ctx.beginPath();
      ctx.arc(cx, cy, centerR * 3, 0, Math.PI * 2);
      ctx.fill();

      // connections center -> branch
      branches.forEach((b, i) => {
        const a = startAngle + i * angleStep;
        const bx = cx + Math.cos(a) * branchR;
        const by = cy + Math.sin(a) * branchR;
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        const mx = (cx + bx) / 2;
        const my = (cy + by) / 2;
        ctx.quadraticCurveTo(mx + (by - cy) * 0.1, my - (bx - cx) * 0.1, bx, by);
        ctx.strokeStyle = b.color + '25';
        ctx.lineWidth = 2;
        ctx.setLineDash([6, 5]);
        ctx.stroke();
        ctx.setLineDash([]);
      });

      // connections branch -> leaves
      branches.forEach((b, i) => {
        const a = startAngle + i * angleStep;
        const bx = cx + Math.cos(a) * branchR;
        const by = cy + Math.sin(a) * branchR;
        const count = b.items.length;
        const spread = Math.min(Math.PI * 0.65, count * 0.28);

        b.items.forEach((item, ii) => {
          const t = count === 1 ? 0 : (ii / (count - 1)) - 0.5;
          const la = a + t * spread;
          const lx = bx + Math.cos(la) * leafDist;
          const ly = by + Math.sin(la) * leafDist;
          ctx.beginPath();
          ctx.moveTo(bx, by);
          ctx.lineTo(lx, ly);
          ctx.strokeStyle = b.color + '12';
          ctx.lineWidth = 1;
          ctx.stroke();
        });
      });

      // leaves
      branches.forEach((b, i) => {
        const a = startAngle + i * angleStep;
        const bx = cx + Math.cos(a) * branchR;
        const by = cy + Math.sin(a) * branchR;
        const count = b.items.length;
        const spread = Math.min(Math.PI * 0.65, count * 0.28);

        b.items.forEach((item, ii) => {
          const t = count === 1 ? 0 : (ii / (count - 1)) - 0.5;
          const la = a + t * spread;
          const lx = bx + Math.cos(la) * leafDist;
          const ly = by + Math.sin(la) * leafDist;

          ctx.font = `500 ${fontSize}px Inter, sans-serif`;
          const tw = ctx.measureText(item).width;
          const pw = tw + 16;
          const ph = fontSize * 1.8;
          const pr = ph / 2;

          ctx.beginPath();
          ctx.roundRect(lx - pw / 2, ly - ph / 2, pw, ph, pr);
          ctx.fillStyle = b.color + '0d';
          ctx.fill();
          ctx.strokeStyle = b.color + '28';
          ctx.lineWidth = 1;
          ctx.stroke();

          ctx.fillStyle = colors.textSec;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(item, lx, ly + 1);

          nodes.push({ x: lx, y: ly, w: pw, h: ph, label: item, color: b.color, type: 'leaf' });
        });
      });

      // branches
      branches.forEach((b, i) => {
        const a = startAngle + i * angleStep;
        const bx = cx + Math.cos(a) * branchR;
        const by = cy + Math.sin(a) * branchR;
        const br = centerR * 0.7;

        const bg = ctx.createRadialGradient(bx, by, 0, bx, by, br * 2.5);
        bg.addColorStop(0, b.color + '12');
        bg.addColorStop(1, b.color + '00');
        ctx.fillStyle = bg;
        ctx.beginPath();
        ctx.arc(bx, by, br * 2.5, 0, Math.PI * 2);
        ctx.fill();

        ctx.beginPath();
        ctx.arc(bx, by, br, 0, Math.PI * 2);
        ctx.fillStyle = b.color + '18';
        ctx.fill();
        ctx.strokeStyle = b.color;
        ctx.lineWidth = 2;
        ctx.stroke();

        ctx.fillStyle = b.color;
        ctx.font = `700 ${fontSize * 1.1}px Inter, sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(b.label, bx, by);

        nodes.push({ x: bx, y: by, r: br, label: b.label, color: b.color, type: 'branch', items: b.items });
      });

      // center
      const cGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, centerR);
      cGrad.addColorStop(0, '#00d4aa');
      cGrad.addColorStop(1, '#7c3aed');
      ctx.beginPath();
      ctx.arc(cx, cy, centerR, 0, Math.PI * 2);
      ctx.fillStyle = cGrad;
      ctx.fill();

      ctx.fillStyle = 'white';
      ctx.font = `800 ${fontSize * 1.4}px Inter, sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('Wesley', cx, cy - fontSize * 0.5);
      ctx.font = `400 ${fontSize}px Inter, sans-serif`;
      ctx.fillStyle = 'rgba(255,255,255,0.75)';
      ctx.fillText('Alves', cx, cy + fontSize * 0.7);

      nodes.push({ x: cx, y: cy, r: centerR, label: 'Wesley Alves', type: 'center' });
    }

    draw();

    let hovered = null;

    canvas.addEventListener('mousemove', (e) => {
      const cr = canvas.getBoundingClientRect();
      const mx = e.clientX - cr.left;
      const my = e.clientY - cr.top;
      let found = null;

      for (const n of nodes) {
        if (n.type === 'center' || n.type === 'branch') {
          if (Math.hypot(mx - n.x, my - n.y) <= (n.r || 30) + 8) { found = n; break; }
        } else {
          if (Math.abs(mx - n.x) < n.w / 2 + 6 && Math.abs(my - n.y) < n.h / 2 + 6) { found = n; break; }
        }
      }

      if (found !== hovered) {
        hovered = found;
        draw();
        if (found && found.type !== 'center') {
          canvas.style.cursor = 'pointer';
          if (tooltip) {
            tooltip.innerHTML = found.type === 'branch'
              ? `<strong style="color:${found.color}">${found.label}</strong><br/><span style="color:var(--text-secondary)">${found.items.join(' · ')}</span>`
              : `<strong style="color:${found.color}">${found.label}</strong>`;
            tooltip.style.opacity = '1';
          }
          // highlight
          if (found.type === 'branch') {
            ctx.beginPath();
            ctx.arc(found.x, found.y, found.r + 5, 0, Math.PI * 2);
            ctx.strokeStyle = found.color + '50';
            ctx.lineWidth = 3;
            ctx.stroke();
          } else {
            ctx.font = `500 ${fontSize}px Inter, sans-serif`;
            const pw = ctx.measureText(found.label).width + 22;
            ctx.beginPath();
            ctx.roundRect(found.x - pw / 2, found.y - found.h / 2 - 2, pw, found.h + 4, found.h / 2 + 2);
            ctx.fillStyle = found.color + '20';
            ctx.fill();
            ctx.strokeStyle = found.color;
            ctx.lineWidth = 1.5;
            ctx.stroke();
          }
        } else {
          canvas.style.cursor = 'default';
          if (tooltip) tooltip.style.opacity = '0';
        }
      }

      if (found && tooltip) {
        tooltip.style.left = (e.clientX - cr.left + 16) + 'px';
        tooltip.style.top = (e.clientY - cr.top - 12) + 'px';
      }
    });

    canvas.addEventListener('mouseleave', () => {
      hovered = null;
      draw();
      if (tooltip) tooltip.style.opacity = '0';
      canvas.style.cursor = 'default';
    });

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const isNowMobile = window.innerWidth < 768;
        if (isNowMobile) {
          wrapper.style.display = 'none';
          return;
        }
        wrapper.style.display = '';
        nodes.length = 0;
        const r = wrapper.getBoundingClientRect();
        canvas.width = r.width * dpr;
        canvas.height = r.height * dpr;
        canvas.style.width = r.width + 'px';
        canvas.style.height = r.height + 'px';
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.scale(dpr, dpr);
        draw();
      }, 200);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', drawMindmap);
  } else {
    drawMindmap();
  }
</script>

<style>
  /* Canvas - Desktop only */
  .mindmap-canvas-wrapper {
    position: relative;
    margin-top: 3rem;
    width: 100%;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--bg-card-border);
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .mindmap-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mindmap-tooltip {
    position: absolute;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
    border: 1px solid var(--bg-card-border);
    color: var(--text-primary);
    font-size: 0.8rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
    z-index: 10;
    max-width: 280px;
    box-shadow: var(--shadow-card);
    line-height: 1.5;
  }

  /* Cards - Mobile */
  .mindmap-cards {
    display: none;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 3rem;
  }

  .mindmap-card {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--bg-card);
    border: 1px solid var(--bg-card-border);
    border-left: 3px solid var(--card-accent);
    transition: all var(--transition);
  }

  .mindmap-card:hover {
    background: var(--bg-card-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }

  .mindmap-card-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .mindmap-card-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .mindmap-card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--card-accent);
  }

  .mindmap-card-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mindmap-card-list li {
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--card-accent, var(--accent));
    background: color-mix(in srgb, var(--card-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--card-accent) 20%, transparent);
    transition: all var(--transition);
  }

  .mindmap-card-list li:hover {
    background: var(--card-accent);
    color: white;
    transform: translateY(-1px);
  }

  .mindmap-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .legend-label {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .mindmap-canvas-wrapper {
      display: none !important;
    }

    .mindmap-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .mindmap-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
