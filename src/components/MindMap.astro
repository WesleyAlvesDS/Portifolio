---
import { resume } from '../data/resume';
const { mindmap } = resume;
---

<section class="section mindmap-section" id="habilidades">
  <div class="container">
    <div data-reveal>
      <p class="section-label">// Habilidades</p>
      <h2 class="section-title">Mapa Mental de Competências</h2>
      <p class="section-subtitle">Visão interativa das minhas habilidades técnicas e ferramentas.</p>
    </div>

    <div class="mindmap-canvas-wrapper" data-reveal="delay-1">
      <canvas class="mindmap-canvas" id="mindmap-canvas"></canvas>
      <div class="mindmap-hint" id="mindmap-hint">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 9l-3 3 3 3"/><path d="M9 5l3-3 3 3"/><path d="M15 19l3-3-3-3"/><path d="M19 9l-3 3 3 3"/></svg>
        Arraste para mover · Scroll para zoom
      </div>
      <div class="mindmap-tooltip" id="mindmap-tooltip"></div>
      <button class="mindmap-reset" id="mindmap-reset" title="Resetar posição">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
      </button>
    </div>

    <div class="mindmap-cards" data-reveal="delay-1">
      {mindmap.branches.map((branch) => (
        <div class="mindmap-card" style={`--card-accent: ${branch.color}`}>
          <div class="mindmap-card-header">
            <span class="mindmap-card-dot" style={`background: ${branch.color}`}></span>
            <h3 class="mindmap-card-title">{branch.label}</h3>
          </div>
          <ul class="mindmap-card-list">
            {branch.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script define:vars={{ mindmap }}>
  function drawMindmap() {
    const canvas = document.getElementById('mindmap-canvas');
    if (!canvas) return;
    const wrapper = canvas.parentElement;
    const isMobile = window.innerWidth < 768;

    if (isMobile) {
      wrapper.style.display = 'none';
      return;
    } else {
      wrapper.style.display = '';
    }

    const tooltip = document.getElementById('mindmap-tooltip');
    const hint = document.getElementById('mindmap-hint');
    const resetBtn = document.getElementById('mindmap-reset');
    const dpr = window.devicePixelRatio || 1;

    const rect = wrapper.getBoundingClientRect();
    const w = rect.width;
    const h = rect.height;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';

    const ctx = canvas.getContext('2d');
    ctx.scale(dpr, dpr);

    // pan & zoom state
    let panX = 0, panY = 0;
    let scale = 1;
    let isDragging = false;
    let dragStartX = 0, dragStartY = 0;
    let panStartX = 0, panStartY = 0;
    let hasDragged = false;

    const cx = w / 2;
    const cy = h / 2;
    const minDim = Math.min(w, h);
    const centerR = minDim * 0.055;
    const branchR = minDim * 0.26;
    const leafDist = minDim * 0.28;
    const fontSize = Math.max(10, minDim * 0.024);

    const branches = mindmap.branches;
    const angleStep = (Math.PI * 2) / branches.length;
    const startAngle = -Math.PI / 2;

    let nodes = [];

    function getThemeColors() {
      const s = getComputedStyle(document.documentElement);
      return {
        text: s.getPropertyValue('--text-primary').trim() || '#e4e4e7',
        textSec: s.getPropertyValue('--text-secondary').trim() || '#a1a1aa',
      };
    }

    function screenToWorld(sx, sy) {
      return {
        x: (sx - panX) / scale,
        y: (sy - panY) / scale,
      };
    }

    function draw() {
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, w, h);
      nodes = [];
      const colors = getThemeColors();

      // apply pan/zoom
      ctx.save();
      ctx.translate(panX, panY);
      ctx.scale(scale, scale);

      // subtle center glow
      const cg = ctx.createRadialGradient(cx, cy, 0, cx, cy, centerR * 4);
      cg.addColorStop(0, 'rgba(0,212,170,0.06)');
      cg.addColorStop(1, 'rgba(0,212,170,0)');
      ctx.fillStyle = cg;
      ctx.beginPath();
      ctx.arc(cx, cy, centerR * 4, 0, Math.PI * 2);
      ctx.fill();

      // smooth curves: center -> branch
      branches.forEach((b, i) => {
        const a = startAngle + i * angleStep;
        const bx = cx + Math.cos(a) * branchR;
        const by = cy + Math.sin(a) * branchR;
        const cpx = cx + Math.cos(a) * branchR * 0.5 + Math.cos(a + 0.3) * branchR * 0.15;
        const cpy = cy + Math.sin(a) * branchR * 0.5 + Math.sin(a + 0.3) * branchR * 0.15;

        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.quadraticCurveTo(cpx, cpy, bx, by);
        ctx.strokeStyle = b.color + '20';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      });

      // smooth curves: branch -> leaves
      branches.forEach((b, i) => {
        const a = startAngle + i * angleStep;
        const bx = cx + Math.cos(a) * branchR;
        const by = cy + Math.sin(a) * branchR;
        const count = b.items.length;
        const spread = Math.min(Math.PI * 0.7, count * 0.3);

        b.items.forEach((item, ii) => {
          const t = count === 1 ? 0 : (ii / (count - 1)) - 0.5;
          const la = a + t * spread;
          const lx = bx + Math.cos(la) * leafDist;
          const ly = by + Math.sin(la) * leafDist;
          const midX = (bx + lx) / 2 + Math.cos(la + 0.5) * leafDist * 0.08;
          const midY = (by + ly) / 2 + Math.sin(la + 0.5) * leafDist * 0.08;

          ctx.beginPath();
          ctx.moveTo(bx, by);
          ctx.quadraticCurveTo(midX, midY, lx, ly);
          ctx.strokeStyle = b.color + '10';
          ctx.lineWidth = 1;
          ctx.stroke();
        });
      });

      // leaf pills
      branches.forEach((b, i) => {
        const a = startAngle + i * angleStep;
        const bx = cx + Math.cos(a) * branchR;
        const by = cy + Math.sin(a) * branchR;
        const count = b.items.length;
        const spread = Math.min(Math.PI * 0.7, count * 0.3);

        b.items.forEach((item, ii) => {
          const t = count === 1 ? 0 : (ii / (count - 1)) - 0.5;
          const la = a + t * spread;
          const lx = bx + Math.cos(la) * leafDist;
          const ly = by + Math.sin(la) * leafDist;

          ctx.font = `500 ${fontSize}px Inter, sans-serif`;
          const tw = ctx.measureText(item).width;
          const pw = tw + 20;
          const ph = fontSize * 2;
          const pr = ph / 2;

          ctx.beginPath();
          ctx.roundRect(lx - pw / 2, ly - ph / 2, pw, ph, pr);
          ctx.fillStyle = b.color + '0a';
          ctx.fill();
          ctx.strokeStyle = b.color + '20';
          ctx.lineWidth = 1;
          ctx.stroke();

          ctx.fillStyle = colors.textSec;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(item, lx, ly + 1);

          nodes.push({ x: lx, y: ly, w: pw, h: ph, label: item, color: b.color, type: 'leaf' });
        });
      });

      // branch circles
      branches.forEach((b, i) => {
        const a = startAngle + i * angleStep;
        const bx = cx + Math.cos(a) * branchR;
        const by = cy + Math.sin(a) * branchR;
        const br = centerR * 0.8;

        const bg = ctx.createRadialGradient(bx, by, 0, bx, by, br * 3);
        bg.addColorStop(0, b.color + '10');
        bg.addColorStop(1, b.color + '00');
        ctx.fillStyle = bg;
        ctx.beginPath();
        ctx.arc(bx, by, br * 3, 0, Math.PI * 2);
        ctx.fill();

        ctx.beginPath();
        ctx.arc(bx, by, br, 0, Math.PI * 2);
        ctx.fillStyle = b.color + '15';
        ctx.fill();
        ctx.strokeStyle = b.color + '80';
        ctx.lineWidth = 1.5;
        ctx.stroke();

        ctx.fillStyle = b.color;
        ctx.font = `600 ${fontSize * 1}px Inter, sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(b.label, bx, by);

        nodes.push({ x: bx, y: by, r: br, label: b.label, color: b.color, type: 'branch', items: b.items });
      });

      // center
      const cGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, centerR);
      cGrad.addColorStop(0, '#00d4aa');
      cGrad.addColorStop(1, '#7c3aed');
      ctx.beginPath();
      ctx.arc(cx, cy, centerR, 0, Math.PI * 2);
      ctx.fillStyle = cGrad;
      ctx.fill();

      ctx.fillStyle = 'white';
      ctx.font = `700 ${fontSize * 1.2}px Inter, sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('Wesley', cx, cy - fontSize * 0.4);
      ctx.font = `400 ${fontSize * 0.8}px Inter, sans-serif`;
      ctx.fillStyle = 'rgba(255,255,255,0.7)';
      ctx.fillText('Alves', cx, cy + fontSize * 0.6);

      nodes.push({ x: cx, y: cy, r: centerR, label: 'Wesley Alves', type: 'center' });

      ctx.restore();
    }

    draw();

    // --- Drag / Pan ---
    function getCanvasXY(e) {
      const cr = canvas.getBoundingClientRect();
      if (e.touches) {
        return { x: e.touches[0].clientX - cr.left, y: e.touches[0].clientY - cr.top };
      }
      return { x: e.clientX - cr.left, y: e.clientY - cr.top };
    }

    function onPointerDown(e) {
      const pos = getCanvasXY(e);
      isDragging = true;
      hasDragged = false;
      dragStartX = pos.x;
      dragStartY = pos.y;
      panStartX = panX;
      panStartY = panY;
      canvas.style.cursor = 'grabbing';
      if (hint) hint.style.opacity = '0';
    }

    function onPointerMove(e) {
      const pos = getCanvasXY(e);

      if (isDragging) {
        const dx = pos.x - dragStartX;
        const dy = pos.y - dragStartY;
        if (Math.abs(dx) > 3 || Math.abs(dy) > 3) hasDragged = true;
        panX = panStartX + dx;
        panY = panStartY + dy;
        draw();
        if (tooltip) tooltip.style.opacity = '0';
        return;
      }

      // hover detection (in world coords)
      const world = screenToWorld(pos.x, pos.y);
      let found = null;
      for (const n of nodes) {
        if (n.type === 'center' || n.type === 'branch') {
          if (Math.hypot(world.x - n.x, world.y - n.y) <= (n.r || 30) + 10) { found = n; break; }
        } else {
          if (Math.abs(world.x - n.x) < n.w / 2 + 8 && Math.abs(world.y - n.y) < n.h / 2 + 8) { found = n; break; }
        }
      }

      if (found !== hovered) {
        hovered = found;
        draw();

        if (found && found.type !== 'center') {
          canvas.style.cursor = 'grab';
          if (tooltip) {
            tooltip.innerHTML = found.type === 'branch'
              ? `<strong style="color:${found.color}">${found.label}</strong><br/><span style="color:var(--text-secondary);font-size:0.75rem">${found.items.join(' · ')}</span>`
              : `<strong style="color:${found.color}">${found.label}</strong>`;
            tooltip.style.opacity = '1';
          }
          // highlight
          ctx.save();
          ctx.translate(panX, panY);
          ctx.scale(scale, scale);
          if (found.type === 'branch') {
            const br = centerR * 0.8;
            ctx.beginPath();
            ctx.arc(found.x, found.y, br + 6, 0, Math.PI * 2);
            ctx.strokeStyle = found.color + '40';
            ctx.lineWidth = 2.5;
            ctx.stroke();
          } else {
            ctx.font = `500 ${fontSize}px Inter, sans-serif`;
            const pw = ctx.measureText(found.label).width + 26;
            const ph = found.h + 6;
            ctx.beginPath();
            ctx.roundRect(found.x - pw / 2, found.y - ph / 2, pw, ph, ph / 2);
            ctx.fillStyle = found.color + '18';
            ctx.fill();
            ctx.strokeStyle = found.color + '80';
            ctx.lineWidth = 1.5;
            ctx.stroke();
          }
          ctx.restore();
        } else {
          canvas.style.cursor = 'default';
          if (tooltip) tooltip.style.opacity = '0';
        }
      }

      if (found && tooltip) {
        const cr2 = canvas.getBoundingClientRect();
        tooltip.style.left = (e.clientX - cr2.left + 16) + 'px';
        tooltip.style.top = (e.clientY - cr2.top - 12) + 'px';
      }
    }

    function onPointerUp() {
      isDragging = false;
      canvas.style.cursor = 'default';
    }

    canvas.addEventListener('mousedown', onPointerDown);
    canvas.addEventListener('mousemove', onPointerMove);
    canvas.addEventListener('mouseup', onPointerUp);
    canvas.addEventListener('mouseleave', () => {
      isDragging = false;
      hovered = null;
      draw();
      if (tooltip) tooltip.style.opacity = '0';
      canvas.style.cursor = 'default';
    });

    // touch
    canvas.addEventListener('touchstart', (e) => { e.preventDefault(); onPointerDown(e); }, { passive: false });
    canvas.addEventListener('touchmove', (e) => { e.preventDefault(); onPointerMove(e); }, { passive: false });
    canvas.addEventListener('touchend', onPointerUp);

    // --- Zoom with scroll ---
    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      const pos = getCanvasXY(e);
      const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;
      const newScale = Math.min(Math.max(scale * zoomFactor, 0.4), 3);

      // zoom toward cursor
      panX = pos.x - (pos.x - panX) * (newScale / scale);
      panY = pos.y - (pos.y - panY) * (newScale / scale);
      scale = newScale;

      if (hint) hint.style.opacity = '0';
      draw();
    }, { passive: false });

    // --- Reset ---
    resetBtn?.addEventListener('click', () => {
      panX = 0; panY = 0; scale = 1;
      draw();
    });

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const isNowMobile = window.innerWidth < 768;
        if (isNowMobile) {
          wrapper.style.display = 'none';
          return;
        }
        wrapper.style.display = '';
        const r = wrapper.getBoundingClientRect();
        canvas.width = r.width * dpr;
        canvas.height = r.height * dpr;
        canvas.style.width = r.width + 'px';
        canvas.style.height = r.height + 'px';
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.scale(dpr, dpr);
        draw();
      }, 200);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', drawMindmap);
  } else {
    drawMindmap();
  }
</script>

<style>
  .mindmap-canvas-wrapper {
    position: relative;
    margin-top: 3rem;
    width: 100%;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--bg-card-border);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    cursor: grab;
  }

  .mindmap-canvas-wrapper:active {
    cursor: grabbing;
  }

  .mindmap-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mindmap-hint {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 100px;
    background: var(--bg-secondary);
    border: 1px solid var(--bg-card-border);
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 500;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.6s ease;
    z-index: 5;
    white-space: nowrap;
  }

  .mindmap-reset {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
    border: 1px solid var(--bg-card-border);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition);
    z-index: 5;
  }

  .mindmap-reset:hover {
    background: var(--accent);
    color: #0a0a0f;
    border-color: var(--accent);
  }

  .mindmap-tooltip {
    position: absolute;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
    border: 1px solid var(--bg-card-border);
    color: var(--text-primary);
    font-size: 0.8rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
    z-index: 10;
    max-width: 280px;
    box-shadow: var(--shadow-card);
    line-height: 1.5;
  }

  .mindmap-cards {
    display: none;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 3rem;
  }

  .mindmap-card {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--bg-card);
    border: 1px solid var(--bg-card-border);
    border-left: 3px solid var(--card-accent);
    transition: all var(--transition);
  }

  .mindmap-card:hover {
    background: var(--bg-card-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }

  .mindmap-card-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .mindmap-card-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .mindmap-card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--card-accent);
  }

  .mindmap-card-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mindmap-card-list li {
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: color-mix(in srgb, var(--card-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--card-accent) 20%, transparent);
    transition: all var(--transition);
  }

  .mindmap-card-list li:hover {
    background: var(--card-accent);
    color: white;
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .mindmap-canvas-wrapper {
      display: none !important;
    }

    .mindmap-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .mindmap-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
