---
import { resume } from '../data/resume';

const services = [
  {
    icon: 'code',
    title: 'Desenvolvimento Web',
    desc: 'Sites, landing pages, sistemas web e ferramentas sob medida.',
    budget: 'A partir de R$ 500',
  },
  {
    icon: 'data',
    title: 'Análise de Dados',
    desc: 'Dashboards, relatórios, ETL e automação de processos com Python e Power BI.',
    budget: 'A partir de R$ 300',
  },
  {
    icon: 'db',
    title: 'Banco de Dados',
    desc: 'Modelagem, criação, otimização e consultoria em SQL e NoSQL.',
    budget: 'A partir de R$ 250',
  },
  {
    icon: 'bot',
    title: 'Automação & IA',
    desc: 'Automações com Python, integração com APIs, chatbots e soluções com IA.',
    budget: 'A partir de R$ 400',
  },
  {
    icon: 'support',
    title: 'Suporte Técnico',
    desc: 'Helpdesk, manutenção de computadores, redes e suporte remoto.',
    budget: 'A partir de R$ 150',
  },
  {
    icon: 'admin',
    title: 'Assistência Administrativa',
    desc: 'Planilhas avançadas, organização documental, gestão de estoque e processos.',
    budget: 'A partir de R$ 200',
  },
];
---

<section class="section contact-section" id="contato">
  <div class="container">

    <div class="cta-banner" data-reveal>
      <div class="cta-content">
        <span class="cta-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Estou disponível para novos projetos
        </span>
        <h2 class="cta-title">Precisa de um profissional de tecnologia?</h2>
        <p class="cta-desc">
          Aceito projetos freelance, consultorias e parcerias. Entre em contato
          para solicitar um orçamento sem compromisso.
        </p>
      </div>
      <a href="#form-contato" class="btn btn-primary cta-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="22" y1="2" x2="11" y2="13"/>
          <polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
        Solicitar Orçamento
      </a>
    </div>

    <div class="services-header" data-reveal>
      <p class="section-label">// Serviços</p>
      <h2 class="section-title">O que posso fazer por você</h2>
      <p class="section-subtitle">Serviços com qualidade profissional e preço justo.</p>
    </div>

    <div class="services-grid" data-reveal="delay-1">
      {services.map((s) => (
        <div class="service-card">
          <div class={`service-icon ${s.icon}`}>
            {s.icon === 'code' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            )}
            {s.icon === 'data' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            )}
            {s.icon === 'db' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
            )}
            {s.icon === 'bot' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="9" cy="16" r="1"/><circle cx="15" cy="16" r="1"/><path d="M12 11V7"/><path d="M9 7h6"/></svg>
            )}
            {s.icon === 'support' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            )}
            {s.icon === 'admin' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
            )}
          </div>
          <div class="service-info">
            <h3 class="service-title">{s.title}</h3>
            <p class="service-desc">{s.desc}</p>
          </div>
          <span class="service-budget">{s.budget}</span>
        </div>
      ))}
    </div>

    <div class="contact-grid">
      <div class="contact-left" data-reveal>
        <p class="section-label">// Contato</p>
        <h2 class="section-title">Fale comigo</h2>
        <p class="section-subtitle">
          Preencha o formulário ou entre em contato diretamente pelo email.
          Respondo em até 24h.
        </p>

        <div class="contact-channels">
          <a href={`mailto:${resume.email}`} class="contact-channel">
            <div class="contact-channel-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <span class="contact-channel-label">Email</span>
              <span class="contact-channel-value">{resume.email}</span>
            </div>
          </a>
          <a href={resume.socials.linkedin} target="_blank" rel="noopener noreferrer" class="contact-channel">
            <div class="contact-channel-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <div>
              <span class="contact-channel-label">LinkedIn</span>
              <span class="contact-channel-value">/in/wesley-alves-pro</span>
            </div>
          </a>
          <a href={resume.socials.github} target="_blank" rel="noopener noreferrer" class="contact-channel">
            <div class="contact-channel-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            </div>
            <div>
              <span class="contact-channel-label">GitHub</span>
              <span class="contact-channel-value">WesleyAlvesDS</span>
            </div>
          </a>
        </div>
      </div>

      <form class="contact-form" id="form-contato" data-reveal="delay-1" data-form-contact>
        <div class="form-row">
          <div class="form-group">
            <label for="name">Nome *</label>
            <input type="text" id="name" name="name" required placeholder="Seu nome completo" />
          </div>
          <div class="form-group">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required placeholder="seu@email.com" />
          </div>
        </div>
        <div class="form-group">
          <label for="service">Tipo de Serviço</label>
          <select id="service" name="service">
            <option value="">Selecione o serviço desejado</option>
            <option value="Desenvolvimento Web">Desenvolvimento Web</option>
            <option value="Análise de Dados">Análise de Dados</option>
            <option value="Banco de Dados">Banco de Dados</option>
            <option value="Automação & IA">Automação & IA</option>
            <option value="Suporte Técnico">Suporte Técnico</option>
            <option value="Assistência Administrativa">Assistência Administrativa</option>
            <option value="Outro">Outro</option>
          </select>
        </div>
        <div class="form-group">
          <label for="budget">Faixa de Orçamento</label>
          <select id="budget" name="budget">
            <option value="">Qual seu orçamento estimado?</option>
            <option value="Abaixo de R$ 300">Abaixo de R$ 300</option>
            <option value="R$ 300 - R$ 500">R$ 300 — R$ 500</option>
            <option value="R$ 500 - R$ 1.000">R$ 500 — R$ 1.000</option>
            <option value="R$ 1.000 - R$ 3.000">R$ 1.000 — R$ 3.000</option>
            <option value="Acima de R$ 3.000">Acima de R$ 3.000</option>
            <option value="A definir">A definir / Preciso de orientação</option>
          </select>
        </div>
        <div class="form-group">
          <label for="message">Descreva seu projeto *</label>
          <textarea id="message" name="message" rows="5" required placeholder="Conte-me sobre seu projeto, prazo expectativo e qualquer detalhe relevante..."></textarea>
        </div>
        <div class="form-honey" aria-hidden="true">
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="btn btn-primary btn-full">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="22" y1="2" x2="11" y2="13"/>
            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
          </svg>
          Enviar solicitação de orçamento
        </button>
        <p class="form-note">Responderei em até 24 horas úteis.</p>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-section { padding-bottom: 2rem; }

  /* CTA Banner */
  .cta-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2.5rem 3rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--accent-glow), var(--accent-secondary-glow));
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    margin-bottom: var(--section-gap);
  }

  .cta-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.8rem;
    border-radius: 100px;
    background: var(--accent);
    color: #0a0a0f;
    font-size: 0.72rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .cta-title {
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .cta-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    max-width: 500px;
    line-height: 1.6;
  }

  .cta-btn {
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* Services */
  .services-header { margin-bottom: 2rem; }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
    margin-bottom: var(--section-gap);
  }

  .service-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    background: var(--bg-card);
    border: 1px solid var(--bg-card-border);
    transition: all var(--transition);
  }

  .service-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }

  .service-icon {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: var(--accent-glow);
    color: var(--accent);
  }

  .service-icon.data { background: #7c3aed15; color: #7c3aed; }
  .service-icon.db { background: #f59e0b15; color: #f59e0b; }
  .service-icon.bot { background: #ef444415; color: #ef4444; }
  .service-icon.support { background: #3b82f615; color: #3b82f6; }
  .service-icon.admin { background: #06b6d415; color: #06b6d4; }

  .service-info { flex: 1; min-width: 0; }

  .service-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
  }

  .service-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 0.4rem;
  }

  .service-budget {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-glow);
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    white-space: nowrap;
    flex-shrink: 0;
    align-self: flex-start;
    margin-top: 0.2rem;
  }

  /* Contact Grid */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: start;
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .contact-channel {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--bg-card);
    border: 1px solid var(--bg-card-border);
    color: var(--text-primary);
    text-decoration: none;
    transition: all var(--transition);
  }

  .contact-channel:hover {
    background: var(--bg-card-hover);
    border-color: var(--accent);
    transform: translateX(4px);
    opacity: 1;
  }

  .contact-channel-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--accent-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    flex-shrink: 0;
  }

  .contact-channel-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-channel-value {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--bg-card-border);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    padding: 0.7rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--input-border);
    background: var(--input-bg);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    transition: all var(--transition);
    resize: vertical;
  }

  .form-group select {
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%23a1a1aa' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    padding-right: 2.5rem;
    cursor: pointer;
  }

  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--text-muted);
  }

  .form-honey {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }

  .btn-full {
    width: 100%;
    justify-content: center;
  }

  .form-note {
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: -0.25rem;
  }

  @media (max-width: 768px) {
    .cta-banner {
      flex-direction: column;
      text-align: center;
      padding: 2rem 1.5rem;
    }

    .cta-desc { margin: 0 auto; }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector('[data-form-contact]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const honey = form.querySelector('[name="website"]') as HTMLInputElement;
    if (honey?.value) return;

    const fd = new FormData(form as HTMLFormElement);
    const name = fd.get('name') || '';
    const email = fd.get('email') || '';
    const service = fd.get('service') || 'Não especificado';
    const budget = fd.get('budget') || 'Não definido';
    const message = fd.get('message') || '';

    const body = [
      `Olá Wesley,`,
      ``,
      `Gostaria de solicitar um orçamento.`,
      ``,
      `Nome: ${name}`,
      `Email: ${email}`,
      `Serviço: ${service}`,
      `Orçamento: ${budget}`,
      ``,
      `Descrição do projeto:`,
      `${message}`,
      ``,
      `Aguardo seu retorno.`,
    ].join('\n');

    const mailto = `mailto:pro.wesleyalves@gmail.com?subject=${encodeURIComponent(`[Orçamento] ${service} — ${name}`)}&body=${encodeURIComponent(body)}`;
    window.location.href = mailto;
  });
</script>
