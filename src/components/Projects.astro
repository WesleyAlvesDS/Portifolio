---
import { resume } from '../data/resume';
---

<section class="section projects-section" id="projetos">
  <div class="container">
    <div data-reveal>
      <p class="section-label">// Projetos</p>
      <h2 class="section-title">Projetos em Destaque</h2>
      <p class="section-subtitle">Projetos reais puxados diretamente do meu GitHub.</p>
    </div>

    <div class="projects-featured" data-reveal="delay-1">
      <article class="project-card project-featured">
        <div class="project-header">
          <div class="project-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
          </div>
          <span class="project-badge">Projeto Acadêmico</span>
        </div>
        <h3 class="project-name">{resume.projects[0].name}</h3>
        <p class="project-subtitle">{resume.projects[0].subtitle}</p>
        <p class="project-context">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          {resume.projects[0].context}
        </p>
        <p class="project-desc">{resume.projects[0].description}</p>
        <div class="project-tags">
          {resume.projects[0].tags.map((tag) => (
            <span class="project-tag">{tag}</span>
          ))}
        </div>
      </article>
    </div>

    <div class="github-section" data-reveal="delay-2">
      <div class="github-header">
        <h3 class="skills-subtitle">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: middle; margin-right: 0.5rem;">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          Repositórios no GitHub
        </h3>
        <a href={resume.socials.github} target="_blank" rel="noopener noreferrer" class="github-link">
          Ver perfil
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>

      <div class="github-grid" id="github-repos">
        <div class="github-loading">
          <div class="spinner"></div>
          <span>Carregando repositórios...</span>
        </div>
      </div>
    </div>

    <div class="skills-section" data-reveal="delay-3">
      <h3 class="skills-subtitle">Habilidades Técnicas</h3>
      <div class="skills-cloud">
        {resume.skills.technical.map((skill, i) => (
          <span class="skill-pill tech">{skill}</span>
        ))}
      </div>

      <h3 class="skills-subtitle" style="margin-top: 2rem;">Ferramentas</h3>
      <div class="skills-cloud">
        {resume.skills.tools.map((tool, i) => (
          <span class="skill-pill tool">{tool}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<script define:vars={{ githubUser: resume.socials.github }}>
  async function fetchGitHubRepos() {
    const container = document.getElementById('github-repos');
    if (!container) return;

    try {
      const resp = await fetch('https://api.github.com/users/WesleyAlvesDS/repos?sort=updated&per_page=12');
      if (!resp.ok) throw new Error('Failed to fetch');
      const repos = await resp.json();

      if (repos.length === 0) {
        container.innerHTML = '<p class="github-empty">Nenhum repositório público encontrado.</p>';
        return;
      }

      const langColors = {
        JavaScript: '#f1e05a', Python: '#3572A5', HTML: '#e34c26', CSS: '#563d7c',
        TypeScript: '#2b7489', R: '#198CE7', 'Jupyter Notebook': '#DA5B0B',
        Shell: '#89e051', JSON: '#292929', Markdown: '#083fa1',
      };

      container.innerHTML = repos.map(repo => `
        <a href="${repo.html_url}" target="_blank" rel="noopener noreferrer" class="github-card">
          <div class="github-card-top">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
            </svg>
            <span class="github-card-name">${repo.name}</span>
          </div>
          <p class="github-card-desc">${repo.description || 'Sem descrição'}</p>
          <div class="github-card-bottom">
            ${repo.language ? `
              <span class="github-card-lang">
                <span class="github-lang-dot" style="background:${langColors[repo.language] || '#999'}"></span>
                ${repo.language}
              </span>
            ` : ''}
            <span class="github-card-stars">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              ${repo.stargazers_count}
            </span>
            <span class="github-card-forks">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"/><path d="M12 12v3"/></svg>
              ${repo.forks_count}
            </span>
            <span class="github-card-updated">${repo.updated_at.split('T')[0]}</span>
          </div>
        </a>
      `).join('');
    } catch (err) {
      container.innerHTML = '<p class="github-empty">Não foi possível carregar os repositórios no momento.</p>';
    }
  }

  fetchGitHubRepos();
</script>

<style>
  .projects-section {
    background: var(--bg-secondary);
  }

  .projects-featured {
    margin-top: 3rem;
    margin-bottom: 3rem;
  }

  .project-featured {
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--bg-card-border);
    transition: all var(--transition);
    position: relative;
    overflow: hidden;
  }

  .project-featured::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--accent-secondary));
  }

  .project-featured:hover {
    background: var(--bg-card-hover);
    border-color: var(--accent);
    box-shadow: var(--shadow-glow);
    transform: translateY(-3px);
  }

  .project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .project-icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--accent-glow), var(--accent-secondary-glow));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
  }

  .project-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    background: var(--accent-glow);
    color: var(--accent);
    font-weight: 500;
  }

  .project-name {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.3rem;
  }

  .project-subtitle {
    font-size: 1rem;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .project-context {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .project-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-tag {
    padding: 0.3rem 0.8rem;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 500;
    background: var(--bg-card-hover);
    color: var(--text-secondary);
    border: 1px solid var(--bg-card-border);
    font-family: var(--font-mono);
  }

  /* GitHub Section */
  .github-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
  }

  .github-link:hover {
    text-decoration: underline;
  }

  .github-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .github-loading {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 3rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .spinner {
    width: 20px;
    height: 20px;
    border: 2px solid var(--bg-card-border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .github-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--bg-card);
    border: 1px solid var(--bg-card-border);
    text-decoration: none;
    transition: all var(--transition);
    gap: 0.5rem;
  }

  .github-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: var(--shadow-glow);
    opacity: 1;
  }

  .github-card-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
  }

  .github-card-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .github-card-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .github-card-bottom {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .github-card-lang {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .github-lang-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .github-card-stars,
  .github-card-forks {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .github-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem;
    color: var(--text-muted);
  }

  .skills-section {
    margin-top: 4rem;
  }

  .skills-subtitle {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .skills-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-pill {
    padding: 0.45rem 1rem;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 500;
    transition: all var(--transition);
    cursor: default;
  }

  .skill-pill.tech {
    background: var(--accent-glow);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .skill-pill.tech:hover {
    background: var(--accent);
    color: #0a0a0f;
    transform: translateY(-2px);
  }

  .skill-pill.tool {
    background: var(--accent-secondary-glow);
    color: var(--accent-secondary);
    border: 1px solid color-mix(in srgb, var(--accent-secondary) 20%, transparent);
  }

  .skill-pill.tool:hover {
    background: var(--accent-secondary);
    color: white;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .github-grid {
      grid-template-columns: 1fr;
    }

    .github-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
